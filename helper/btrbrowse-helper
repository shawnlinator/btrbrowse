#!/usr/bin/python3 -I
"""Privileged helper for btrbrowse, run as root through pkexec.

Self-contained on purpose: it only imports the standard library, so nothing the
invoking user can write is ever loaded as root. It only acts on snapshots that
btrbk itself reports for a root-owned, non-writable btrbk configuration file.
"""
import argparse
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import time

DEFAULT_CONFIG = "/etc/btrbk/btrbk.conf"
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
LIST_KINDS = ("snapshots", "backups", "config", "target")


class HelperError(Exception):
    pass


def trusted_file(path):
    """Resolve path and require it, and every parent, to be root-owned and not group/world writable."""
    real = os.path.realpath(path)
    if not os.path.isfile(real):
        raise HelperError("config file not found: %s" % path)
    cur = real
    while True:
        st = os.stat(cur)
        if st.st_uid != 0 or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise HelperError("refusing to use %s: %s must be owned by root and "
                              "not writable by group/others" % (path, cur))
        parent = os.path.dirname(cur)
        if parent == cur:
            return real
        cur = parent


def run(cmd, check=True, ok=(0,)):
    env = {"PATH": SAFE_PATH, "LC_ALL": "C", "LANG": "C"}
    proc = subprocess.run(cmd, env=env, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, universal_newlines=True)
    if check and proc.returncode not in ok:
        raise HelperError("%s failed (%d): %s" % (cmd[0], proc.returncode,
                                                  proc.stderr.strip()))
    return proc


def btrbk(config, *args):
    """Run btrbk; exit code 10 means some sections were skipped (e.g. an unmounted
    volume) while the rest worked, so keep the output and pass the warnings on."""
    proc = run(["btrbk", "-c", config] + list(args), ok=(0, 10))
    if proc.returncode == 10 and proc.stderr.strip():
        sys.stderr.write(proc.stderr)
    return proc.stdout


def parse_raw(text):
    rows = []
    for line in text.splitlines():
        if line.startswith("format="):
            rows.append(dict((m.group(1), m.group(2))
                             for m in re.finditer(r"(\w+)='([^']*)'", line)))
    return rows


def known_snapshots(config):
    """{snapshot_subvolume: row} for local snapshots btrbk knows about."""
    rows = parse_raw(btrbk(config, "list", "snapshots", "--format=raw"))
    return {r["snapshot_subvolume"]: r for r in rows
            if r.get("source_host", "") == "" and r.get("snapshot_subvolume")}


def get_snapshot(config, path):
    snaps = known_snapshots(config)
    real = os.path.realpath(path)
    for sub, row in snaps.items():
        if os.path.realpath(sub) == real:
            return sub, row
    raise HelperError("not a btrbk snapshot of this configuration: %s" % path)


def safe_relpath(rel):
    rel = rel.lstrip("/")
    parts = rel.split("/")
    if not rel or any(p in ("", ".", "..") for p in parts):
        raise HelperError("invalid path: %r" % rel)
    return rel


def within(path, root):
    root = os.path.realpath(root)
    return path == root or path.startswith(root + os.sep)


def is_subvolume(path):
    return run(["btrfs", "subvolume", "show", path], check=False).returncode == 0


def is_mountpoint(path):
    """True if path is a real mount point. os.path.ismount() is wrong here: every
    btrfs subvolume has its own st_dev and so looks like a mount point."""
    path = os.path.realpath(path)
    with open("/proc/self/mountinfo") as f:
        for line in f:
            target = line.split()[4]
            target = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), target)
            if target == path:
                return True
    return False


def cmd_list(args):
    if args.kind not in LIST_KINDS:
        raise HelperError("unknown list kind: %s" % args.kind)
    sys.stdout.write(btrbk(args.config, "list", args.kind, "--format=raw"))


def cmd_dump(args):
    """All list kinds plus the log in one call, so a refresh needs a single elevation."""
    for kind in LIST_KINDS:
        print("@@ %s" % kind)
        sys.stdout.write(btrbk(args.config, "list", kind, "--format=raw"))
    print("@@ log")
    cmd_log(args)


def cmd_log(args):
    with open(args.config) as f:
        match = re.search(r"^\s*transaction_log\s+(\S+)", f.read(), re.M)
    if not match:
        return
    try:
        with open(match.group(1)) as f:
            lines = f.readlines()
    except OSError as e:
        raise HelperError("cannot read transaction log: %s" % e)
    sys.stdout.write("".join(lines[-args.lines:]))


def cmd_snapshot(args):
    cmd = ["snapshot"]
    if args.source:
        sources = set(r["source_subvolume"] for r in
                      parse_raw(btrbk(args.config, "list", "config", "--format=raw")))
        if args.source not in sources:
            raise HelperError("not a configured source: %s" % args.source)
        cmd.append(args.source)
    sys.stdout.write(btrbk(args.config, *cmd))


TMP_PREFIX = ".btrbrowse-tmp-"


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def sweep_stale_temp(directory):
    """Remove temporary read-only snapshots left behind by a killed helper."""
    for name in os.listdir(directory):
        m = re.match(r"^%s(\d+)$" % re.escape(TMP_PREFIX), name)
        path = os.path.join(directory, name)
        if m and not pid_alive(int(m.group(1))) and is_subvolume(path):
            run(["btrfs", "subvolume", "delete", "--", path], check=False)


def stream_ok(send_rc, send_err, recv_rc, recv_err):
    """`btrfs receive --dump` exits (successfully) at the end-of-stream marker without
    draining what `btrfs send` still writes, so on large streams send dies from SIGPIPE.
    That is fine as long as receive succeeded and send reported no error of its own."""
    if recv_rc != 0 or recv_err.strip():
        return False
    return send_rc == 0 or (send_rc == -signal.SIGPIPE and not send_err.strip())


def cmd_stream_diff(args):
    """Print the `btrfs receive --dump` of the --no-data incremental stream between two snapshots.

    Read-only apart from, with --live, one short-lived read-only snapshot of the live
    subvolume next to the snapshots (btrfs can only send read-only subvolumes).
    """
    begin, brow = get_snapshot(args.config, args.begin)
    temp = None
    if args.live:
        live = os.path.realpath(brow["source_subvolume"])
        directory = os.path.dirname(begin)
        sweep_stale_temp(directory)
        temp = os.path.join(directory, "%s%d" % (TMP_PREFIX, os.getpid()))
        run(["btrfs", "subvolume", "snapshot", "-r", "--", live, temp])
        end = temp
    else:
        end, erow = get_snapshot(args.config, args.end)
        if erow["source_subvolume"] != brow["source_subvolume"]:
            raise HelperError("snapshots belong to different subvolumes")
    try:
        env = {"PATH": SAFE_PATH, "LC_ALL": "C", "LANG": "C"}
        send = subprocess.Popen(["btrfs", "send", "-q", "--no-data", "-p", begin, end],
                                env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        recv = subprocess.Popen(["btrfs", "receive", "--dump"], env=env, stdin=send.stdout,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                universal_newlines=True, errors="surrogateescape")
        send.stdout.close()
        out, err = recv.communicate()
        send_err = send.stderr.read().decode(errors="replace")
        send.wait()
        if not stream_ok(send.returncode, send_err, recv.returncode, err):
            raise HelperError("btrfs send/receive failed: %s" % (send_err.strip() or err.strip()))
        sys.stdout.write(out)
    finally:
        if temp:
            run(["btrfs", "subvolume", "delete", "--", temp], check=False)


def cmd_delete(args):
    targets = [get_snapshot(args.config, p)[0] for p in args.snapshots]
    for sub in targets:
        if not is_subvolume(sub):
            raise HelperError("not a subvolume: %s" % sub)
    for sub in targets:
        if args.dry_run:
            print("would delete subvolume %s" % sub)
        else:
            run(["btrfs", "subvolume", "delete", "--", sub])
            print("deleted subvolume %s" % sub)


def cmd_restore(args):
    snap, row = get_snapshot(args.config, args.snapshot)
    live = row["source_subvolume"]
    rel = safe_relpath(args.path)
    src = os.path.join(snap, rel)
    dst = os.path.join(live, rel)
    if not os.path.lexists(src):
        raise HelperError("%s does not exist in the snapshot" % rel)
    if not within(os.path.realpath(os.path.dirname(src)), snap):
        raise HelperError("path escapes the snapshot: %s" % rel)
    if not within(os.path.realpath(os.path.dirname(dst)), live):
        raise HelperError("path escapes the subvolume: %s" % rel)
    print("restore %s -> %s" % (src, dst))
    if args.dry_run:
        return
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.isdir(src) and not os.path.islink(src):
        if os.path.lexists(dst) and not os.path.isdir(dst):
            os.unlink(dst)
        os.makedirs(dst, exist_ok=True)
        run(["cp", "-a", "--reflink=auto", "--", src + "/.", dst + "/"])
    else:
        run(["cp", "-a", "--reflink=auto", "--remove-destination", "--", src, dst])


def cmd_rollback(args):
    snap, row = get_snapshot(args.config, args.snapshot)
    live = os.path.realpath(row["source_subvolume"])
    if not is_subvolume(snap) or not is_subvolume(live):
        raise HelperError("both the snapshot and %s must be btrfs subvolumes" % live)
    if is_mountpoint(live):
        raise HelperError("%s is a mount point; a mounted subvolume cannot be "
                          "swapped. Mount the top-level volume and roll back "
                          "from there, or use restore for single files." % live)
    backup = "%s.rollback.%s" % (live, time.strftime("%Y%m%dT%H%M%S"))
    if os.path.lexists(backup):
        raise HelperError("%s already exists" % backup)
    print("rename   %s -> %s" % (live, backup))
    print("snapshot %s -> %s (writable)" % (snap, live))
    print("the old data stays available at %s" % backup)
    if args.dry_run:
        return
    os.rename(live, backup)
    try:
        run(["btrfs", "subvolume", "snapshot", "--", snap, live])
    except HelperError:
        os.rename(backup, live)
        raise
    print("done")


def main(argv):
    parser = argparse.ArgumentParser(prog="btrbrowse-helper")
    parser.add_argument("--config", default=DEFAULT_CONFIG)
    sub = parser.add_subparsers(dest="verb", required=True)

    p = sub.add_parser("list")
    p.add_argument("kind")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("log")
    p.add_argument("--lines", type=int, default=500)
    p.set_defaults(func=cmd_log)

    p = sub.add_parser("dump")
    p.add_argument("--lines", type=int, default=500)
    p.set_defaults(func=cmd_dump)

    p = sub.add_parser("snapshot")
    p.add_argument("source", nargs="?")
    p.set_defaults(func=cmd_snapshot)

    p = sub.add_parser("stream-diff")
    p.add_argument("--live", action="store_true", help="compare BEGIN with the live subvolume")
    p.add_argument("begin")
    p.add_argument("end", nargs="?")
    p.set_defaults(func=cmd_stream_diff)

    p = sub.add_parser("delete")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("snapshots", nargs="+")
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("restore")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("snapshot")
    p.add_argument("path")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("rollback")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("snapshot")
    p.set_defaults(func=cmd_rollback)

    args = parser.parse_args(argv)
    if args.verb == "stream-diff" and not args.live and not args.end:
        parser.error("stream-diff needs END or --live")
    if os.geteuid() != 0:
        print("btrbrowse-helper must run as root", file=sys.stderr)
        return 2
    try:
        args.config = trusted_file(args.config)
        args.func(args)
    except HelperError as e:
        print("error: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
